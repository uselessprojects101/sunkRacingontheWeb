# Sonic R -> WebAssembly (Emscripten).  Run from source/sdl:
#   emmake make -f Makefile.emscripten
# Output: build-wasm/sonicr.{js,wasm,data}  (web/index.html is the real page)

CC      = emcc
SRCDIR  = src
OUTDIR  = build-wasm

# No UPnP / BearSSL matchmaker / pthreads in the browser. matchmaker.c and
# net_https.c gate themselves on SONICR_MATCHMAKER, so leaving the define off
# turns them into stubs. net_upnp.c needs miniupnpc, so it's excluded.
CSRC = $(shell find $(SRCDIR) -name '*.c' \
          ! -path '$(SRCDIR)/gles2/*' \
          ! -path '$(SRCDIR)/net/bearssl/*' \
          ! -name 'net_upnp.c')

COBJS = $(patsubst $(SRCDIR)/%.c,$(OUTDIR)/obj/%.o,$(CSRC))

CFLAGS = -I$(SRCDIR) -std=c11 -O2 -fno-common -w \
         -D_GNU_SOURCE -DSONICR_SDL \
         -sUSE_SDL=2 -sUSE_SDL_MIXER=2 -sSDL2_MIXER_FORMATS='["ogg","mp3","wav"]'

# LEGACY_GL_EMULATION: the renderer uses fixed-function GL (glBegin etc.).
# ASYNCIFY: the game has blocking loops that call emscripten_sleep().
# INVOKE_RUN=0: web/index.html calls main() itself once the player's game
#               data is in the virtual filesystem.
LDFLAGS = $(CFLAGS) -lm -lidbfs.js \
          -sLEGACY_GL_EMULATION=1 \
          -sASYNCIFY=1 -sASYNCIFY_STACK_SIZE=262144 \
          -sALLOW_MEMORY_GROWTH=1 -sINITIAL_MEMORY=268435456 -sSTACK_SIZE=2097152 \
          -sINVOKE_RUN=0 -sFORCE_FILESYSTEM=1 \
          -sEXPORTED_RUNTIME_METHODS='["callMain","FS","IDBFS"]' \
          -sEXIT_RUNTIME=0 \
          --preload-file ../../DATA@/bundle

TARGET = $(OUTDIR)/sonicr.js

all: $(TARGET)

$(TARGET): $(COBJS)
	$(CC) -o $@ $^ $(LDFLAGS)

$(OUTDIR)/obj/%.o: $(SRCDIR)/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c -o $@ $<

clean:
	rm -rf $(OUTDIR)

.PHONY: all clean
